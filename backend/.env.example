# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
PORT=5000

# 'production' in a real deployment: it switches request logging to the combined
# format. 'test' is set by the test suite itself.
NODE_ENV=development

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/job-portal
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/job-portal
MONGO_URI=mongodb://127.0.0.1:27017/job-portal

# --- CORS ---
# Comma-separated list of browser origins allowed to call this API. Set this to
# your deployed frontend URL; anything not listed is refused with 403.
# Left blank, it falls back to the local Vite dev servers.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth (JWT) ---
# Two separate secrets so a refresh token can never be replayed as an access
# token. JWT_SECRET alone is enough: the refresh secret is then derived from it
# so the two still differ. The server REFUSES TO START if neither is set.
JWT_SECRET=change_this_to_a_long_random_string
JWT_ACCESS_SECRET=change_this_to_a_long_random_access_secret
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_refresh_secret

# Access token lifetime. Kept at 1 minute as required; the frontend silently
# exchanges the refresh token for a new one, so users are not logged out.
# NOTE: JWT_EXPIRES_IN is NOT a recognised variable — nothing reads it. The
# live names are JWT_ACCESS_EXPIRES_IN and JWT_REFRESH_EXPIRES_IN below; the
# server warns at boot if it finds a stale JWT_EXPIRES_IN in the environment.
JWT_ACCESS_EXPIRES_IN=1m
# Refresh token lifetime. Each one is recorded in the `refreshtokens` collection
# and revoked when rotated, so this is the ceiling on a session's life, not on a
# leaked token's — a rotated-out token stops working immediately.
JWT_REFRESH_EXPIRES_IN=7d

# --- Email verification OTP ---
# Pepper for OTP hashes. REQUIRED — the server refuses to start without it.
# A 6-digit code is trivially brute-forced from a leaked hash without this.
# Rotating it invalidates only in-flight codes (10 minutes' worth).
OTP_SECRET=change_this_to_a_long_random_otp_secret

# --- Google Sign-In ---
# OAuth 2.0 *Web application* client ID from the Google Cloud Console. Add your
# FRONTEND origins (http://localhost:5173 and your deployed URL) under
# "Authorised JavaScript origins". No client secret and no redirect URI are
# needed: the frontend obtains an ID token and this API verifies it.
# Left blank, POST /api/auth/google answers 503 and the frontend hides the button.
GOOGLE_CLIENT_ID=

# --- Default admin (created by `npm run seed`) ---
ADMIN_EMAIL=admin@portal.com
ADMIN_PASSWORD=admin123

# --- Cloudinary (resume upload) --- get these from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Nodemailer via Gmail) ---
# REQUIRED IN PRODUCTION: registration now sends a verification code, so with
# these unset and NODE_ENV=production, POST /api/auth/register answers 503.
# Outside production the code is logged and returned as `devOtp` instead.
# EMAIL_PASS must be a Gmail "App Password" (16 chars), NOT your normal password.
# Create one at: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=
