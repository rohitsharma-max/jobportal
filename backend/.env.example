# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
PORT=5000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/job-portal
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/job-portal
MONGO_URI=mongodb://127.0.0.1:27017/job-portal

# --- Auth (JWT) ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Default admin (created by `npm run seed`) ---
ADMIN_EMAIL=admin@portal.com
ADMIN_PASSWORD=admin123

# --- Cloudinary (resume upload) --- get these from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Nodemailer via Gmail) ---
# EMAIL_PASS must be a Gmail "App Password" (16 chars), NOT your normal password.
# Create one at: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=
