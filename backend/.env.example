# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
PORT=5000

# 'production' in a real deployment: it switches request logging to the combined
# format. 'test' is set by the test suite itself.
NODE_ENV=development

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/job-portal
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/job-portal
MONGO_URI=mongodb://127.0.0.1:27017/job-portal

# --- CORS ---
# Comma-separated list of browser origins allowed to call this API. Set this to
# your deployed frontend URL; anything not listed is refused with 403.
# Left blank, it falls back to the local Vite dev servers.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth (JWT) ---
# Two separate secrets so a refresh token can never be replayed as an access
# token. JWT_SECRET is the fallback if either is left blank.
JWT_SECRET=change_this_to_a_long_random_string
JWT_ACCESS_SECRET=change_this_to_a_long_random_access_secret
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_refresh_secret

# Access token lifetime. Kept at 1 minute as required; the frontend silently
# exchanges the refresh token for a new one, so users are not logged out.
JWT_ACCESS_EXPIRES_IN=1m
# Refresh token lifetime. Each one is recorded in the `refreshtokens` collection
# and revoked when rotated, so this is the ceiling on a session's life, not on a
# leaked token's — a rotated-out token stops working immediately.
JWT_REFRESH_EXPIRES_IN=7d

# --- Default admin (created by `npm run seed`) ---
ADMIN_EMAIL=admin@portal.com
ADMIN_PASSWORD=admin123

# --- Cloudinary (resume upload) --- get these from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Nodemailer via Gmail) ---
# EMAIL_PASS must be a Gmail "App Password" (16 chars), NOT your normal password.
# Create one at: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=
