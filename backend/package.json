{
  "name": "job-portal-backend",
  "version": "1.0.0",
  "description": "Backend API for the Internship & Job Listing Portal (Express + MongoDB)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/seed.js",
    "backfill:status": "node src/scripts/backfill-status.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
