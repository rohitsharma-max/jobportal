# Copy to ".env" and adjust. Only VITE_-prefixed vars reach the browser bundle,
# and everything here IS public once built — never put a secret in this file.

# Base URL of the backend API, including the /api prefix.
VITE_API_URL=http://localhost:5000/api

# Your Cloudinary cloud name — the same value as CLOUDINARY_CLOUD_NAME in the
# backend .env. Optional but recommended: the admin resume preview only embeds
# files served from THIS cloud and offers every other resume link as an
# open-in-new-tab link rather than framing it. Left blank, the check falls back
# to accepting any res.cloudinary.com URL.
VITE_CLOUDINARY_CLOUD_NAME=
